# Phoenix Zero - Example env (DO NOT put real secrets here)

# Public URL used by share-link to rewrite internal URLs
PHOENIX_ZERO_PUBLIC_BASE_URL=http://localhost:3000

# Signing keys (DEV ONLY)
# Generate Ed25519 key via your existing keygen script and set it here.
PHOENIX_ZERO_PRIVATE_KEY_B64URL=

# PQ keys (DEV ONLY)
# If unset, some flows may read keys/phoenix-zero-sphincs.json (which should NOT be committed)
PHOENIX_ZERO_PQ_PRIVATE_KEY_B64URL=
PHOENIX_ZERO_PQ_PUBLIC_KEY_B64URL=

# SSRF hardening for verify-by-url
# In production, allowlist is required by default.
# Comma-separated domains (supports subdomains). Example: youtube.com,tiktok.com,instagram.com
PHOENIX_ZERO_VERIFY_URL_ALLOWLIST=
# 1=force require, 0=disable require, empty=auto(require in production)
PHOENIX_ZERO_VERIFY_URL_REQUIRE_ALLOWLIST=
# 1=allow localhost/private networks (NOT recommended)
PHOENIX_ZERO_VERIFY_URL_ALLOW_LOCALHOST=0
# Fetch timeout for verify-by-url
PHOENIX_ZERO_VERIFY_URL_FETCH_TIMEOUT_MS=15000
# Max download sizes
PHOENIX_ZERO_VERIFY_URL_MAX_PROOF_BYTES=1048576
PHOENIX_ZERO_VERIFY_URL_MAX_VIDEO_BYTES=209715200

# Upload limits
PHOENIX_ZERO_VERIFY_WATERMARKED_MAX_VIDEO_BYTES=52428800
PHOENIX_ZERO_STAMP_MAX_VIDEO_BYTES=52428800
PHOENIX_ZERO_STAMP_WATERMARKED_MAX_VIDEO_BYTES=52428800
PHOENIX_ZERO_STAMP_IMAGE_WATERMARKED_MAX_IMAGE_BYTES=10485760

PHOENIX_ZERO_TMP_DIR=

# Live stream
LIVE_STREAM_DIR=
# 1=allow reading legacy process.cwd()/tmp/live-stream (NOT recommended)
PHOENIX_ZERO_LIVE_STREAM_ALLOW_LEGACY_DIR=0
# 1=force persist secrets.json to disk, 0=disable, empty=auto(enabled in dev)
PHOENIX_ZERO_LIVE_STREAM_PERSIST_SECRETS=
PHOENIX_ZERO_LIVE_STREAM_MAX_START_VIDEO_BYTES=52428800
PHOENIX_ZERO_LIVE_STREAM_MAX_SEGMENT_BYTES=26214400

# Share-link basic rate limit (in-memory)
PHOENIX_ZERO_SHARE_LINK_RPM=60

# Auth-proxy already has its own rate limit
PHOENIX_ZERO_AUTH_PROXY_RPM=120
PHOENIX_ZERO_AUTH_PROXY_TTL_SECONDS=30
