{
  "name": "phoenix-zero",
  "private": true,
  "dependencies": {
    "@phoenix-zero/core": "file:./libs/phoenix-zero"
  },
  "scripts": {
    "bootstrap": "npm install && npm --prefix ./apps/web install && npm --prefix ./apps/mobile install",
    "make:testvideo": "tsx ./scripts/phoenix-zero-make-test-video.ts",
    "test:agentic": "tsx ./agentic-stress-test.ts",
    "test:agentic:real": "powershell -NoProfile -Command \"$env:AGENTIC_STRESS_REAL='1'; $env:AGENTIC_STRESS_REAL_PROVIDER='pix'; tsx ./agentic-stress-test.ts\"",
    "test:agentic:real:pix": "powershell -NoProfile -Command \"$env:AGENTIC_STRESS_REAL='1'; $env:AGENTIC_STRESS_REAL_PROVIDER='pix'; tsx ./agentic-stress-test.ts\"",
    "test:agentic:real:crypto": "powershell -NoProfile -Command \"$env:AGENTIC_STRESS_REAL='1'; $env:AGENTIC_STRESS_REAL_PROVIDER='crypto'; tsx ./agentic-stress-test.ts\"",
    "test:agentic:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agentic-stress-e2e.ps1 -Mode deterministic",
    "test:agentic:e2e:real:pix": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agentic-stress-e2e.ps1 -Mode real:pix",
    "test:agentic:e2e:real:crypto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agentic-stress-e2e.ps1 -Mode real:crypto",
    "dev:web": "npm --prefix ./apps/web run dev",
    "start:web": "npm --prefix ./apps/web run start --",
    "dev:mobile": "npm --prefix ./apps/mobile run start",
    "build:core": "npm --prefix ./libs/phoenix-zero run build",
    "build:web": "npm --prefix ./apps/web run build",
    "build": "npm run build:core && npm run build:web",
    "anchor:profiles": "tsx ./scripts/phoenix-zero-anchor-cli.ts profiles",
    "anchor:suggest": "tsx ./scripts/phoenix-zero-anchor-cli.ts suggest",
    "anchor:hash": "tsx ./scripts/phoenix-zero-anchor-cli.ts hash",
    "anchor:create": "tsx ./scripts/phoenix-zero-anchor-cli.ts create",
    "anchor:verify": "tsx ./scripts/phoenix-zero-anchor-cli.ts verify",
    "anchor:log": "tsx ./scripts/phoenix-zero-anchor-cli.ts log",
    "anchor:demo": "tsx ./scripts/phoenix-zero-anchor-cli.ts demo",
    "keygen": "tsx ./scripts/phoenix-zero-keygen.ts",
    "pq:keygen": "tsx ./scripts/phoenix-zero-pq-keygen.ts",
    "stamp:video": "tsx ./scripts/phoenix-zero-stamp-video.ts",
    "verify:video": "tsx ./scripts/phoenix-zero-verify-video.ts",
    "stamp:wm": "tsx ./scripts/phoenix-zero-stamp-watermarked.ts",
    "verify:wm": "tsx ./scripts/phoenix-zero-verify-watermarked.ts",
    "stamp:image:wm": "tsx ./scripts/phoenix-zero-stamp-image-watermarked.ts",
    "verify:image:wm": "tsx ./scripts/phoenix-zero-verify-image-watermarked.ts",
    "stamp:audio:wm": "tsx ./scripts/phoenix-zero-stamp-audio-watermarked.ts",
    "verify:audio:wm": "tsx ./scripts/phoenix-zero-verify-audio-watermarked.ts",
    "bench:presets": "tsx ./scripts/phoenix-zero-benchmark-presets.ts",
    "init:platform-tests": "powershell -ExecutionPolicy Bypass -File ./scripts/init-platform-tests.ps1",
    "test:platforms": "powershell -ExecutionPolicy Bypass -File ./scripts/test-all-platforms.ps1",
    "test:image:platforms": "powershell -ExecutionPolicy Bypass -File ./scripts/test-image-platforms.ps1",
    "test:audio:platforms": "powershell -ExecutionPolicy Bypass -File ./scripts/test-audio-platforms.ps1",
    "test:core": "tsx ./scripts/phoenix-zero-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:robust:image": "tsx ./scripts/phoenix-zero-image-wm-robustness.ts",
    "test:robust:video": "tsx ./scripts/phoenix-zero-video-wm-reencode.ts",
    "test:social:flows": "playwright test e2e/social-flows.spec.ts --headed"
  },
  "devDependencies": {
    "@types/node": "^20.11.10",
    "@playwright/test": "^1.41.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "sphincs": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
